<!DOCTYPE html>
<html lang="fr">
  <head>
    <% page_title = safe_join([ content_for(:title), "Chez Maurice Production" ].compact.uniq, " · ") %>
    <% description = content_for(:description) || "Chez Maurice Production, studio de conseil et de production audiovisuelle à Rueil-Malmaison." %>
    <% canonical_url = content_for(:canonical) || request.base_url + request.path %>
    <% share_image = content_for(:share_image) || image_url("carte-sociale.png") %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:type" content="<%= content_for(:og_type) || "website" %>">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="Chez Maurice Production">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= share_image %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= share_image %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "favicon.png" %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="page-shell flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
        <%= link_to root_path, class: "brand", aria: { label: "Chez Maurice Production, accueil" } do %>
          <%= image_tag "chez-maurice-entete.webp", alt: "", width: 56, height: 56 %>
          <span>Chez Maurice<span class="brand-subtitle">Production</span></span>
        <% end %>
        <nav class="main-nav flex items-center" aria-label="Navigation principale">
          <%= link_to "Réalisations", realisations_path, aria: { current: ("page" if controller_name == "realisations" && action_name == "index") } %>
          <%= link_to "Le studio", root_path, aria: { current: ("page" if current_page?(root_path)) } %>
          <%= link_to contact_path, class: "contact-link", aria: { current: ("page" if current_page?(contact_path)) } do %>
            Contact <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          <% end %>
        </nav>
      </div>
    </header>
    <main id="contenu" tabindex="-1"><%= yield %></main>
    <footer class="site-footer">
      <div class="page-shell flex flex-wrap items-center justify-between gap-4">
        <span>© <%= Date.current.year %> Chez Maurice Production</span>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          <%= link_to "Mentions légales", mentions_legales_path %>
          <%= link_to "https://www.linkedin.com/company/chezmauriceproduction/" do %>
            <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i> LinkedIn
          <% end %>
        </div>
      </div>
    </footer>
  </body>
</html>
