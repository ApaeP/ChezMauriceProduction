# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore Git metadata in both checkouts and worktrees.
/.git
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets
/public/packs
/app/icon.png

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer
/.ruby-lsp
/*.docx

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Outils de déploiement, données locales et sauvegardes
/bin/deploy
/.github
/test
/.local
/.aws
/.ssh
/.codex
/.agents
/vendor/bundle
**/.env*
**/*.key
**/*.pem
**/*.sqlite3*
**/*.dump
**/*.tar.gz
**/.DS_Store
